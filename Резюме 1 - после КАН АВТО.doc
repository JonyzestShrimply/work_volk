\par \uc0\u1040 \uc0\u1085 \uc0\u1075 \uc0\u1083 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  A2 \uc0\u8212  \uc0\u1069 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1088 \uc0\u1085 \uc0\u1099 \uc0\u1081 }
